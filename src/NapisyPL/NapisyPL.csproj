<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NapisyPL</AssemblyName>
    <RootNamespace>NapisyPL</RootNamespace>
    <ApplicationIcon>Assets\subflow.ico</ApplicationIcon>
    <Product>SubFlow</Product>
    <AssemblyTitle>SubFlow</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <ProjectReference Include="../NapisyPL.Core/NapisyPL.Core.csproj" />
  </ItemGroup>
</Project>
